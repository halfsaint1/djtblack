# Booking form email delivery (https://resend.com)
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate for several). Defaults to hello@djtblack.com.
BOOKING_TO_EMAIL=hello@djtblack.com
# Sender. Must be on a domain verified in Resend, e.g. "DJ TBLACK Website <bookings@djtblack.com>".
# Until the domain is verified, Resend only delivers from onboarding@resend.dev to the account owner's email.
BOOKING_FROM_EMAIL=DJ TBLACK Website <bookings@djtblack.com>
